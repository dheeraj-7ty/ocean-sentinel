  "reconciled_historical_inconsistencies": {
    "A_channels": {
      "inconsistency": "Earlier documentation described VV/VH dual-pol, whereas C22-A.9 executable truth is single-band VV.",
      "classification": "DOCUMENTATION_ERROR",
      "evidence": "Sentinel-1 Level-1 GRD crops derived from the Li IW archive contain solely single-channel VV raster data (256x256 GeoTIFF). The dataloader and conv1 network adaptation consume exactly 1 channel. 'VV/VH' in early report narrative was a typographical misnomer.",
      "verdict": "RESOLVED_AS_DOCUMENTATION_ERROR"
    },
    "B_initialization": {
      "inconsistency": "Early draft protocol described from-scratch / Kaiming initialization, whereas C22-A.9 reported initial_model_state_canonical.pt with ImageNet ResNet18 initialization.",
      "classification": "VERSIONED_CHANGE",
      "evidence": "The initial proposal (OPEN-ARCH-001 in exp07_protocol_design_v1.json) contemplated Kaiming from-scratch, but the frozen protocol contracts (C4, C15, C22-A.3, C22-A.4) formally adopted ImageNet pre-trained ResNet18 (IMAGENET1K_V1, conv1 mean-slice adaptation) with Kaiming uniform decoder under seed 42. Checkpoint initial_model_state_canonical.pt (SHA256: 67181C4ECD420DEABA4129AB67AA34D617C1C581ACB3A1A7A9DE8BEAF2F1544D) was verified bitwise across C22-B and C22-D runs.",
      "verdict": "RESOLVED_AS_VERSIONED_CHANGE"
    },
    "C_training_schedule": {
      "inconsistency": "Early protocol documentation described 50 epochs / patience 15, whereas C22-A.9 executable truth described MAX_EPOCHS = 30, MIN_EPOCHS = 15, PATIENCE = 10.",
      "classification": "VERSIONED_CHANGE",
      "evidence": "The early Phase 7B / EXP-07-P0 draft proposal proposed 50 epochs (patience 15). During protocol freeze (C7, C8, C15, C21), the schedule was formally shortened to MAX_EPOCHS = 30, MIN_EPOCHS = 15, PATIENCE = 10 to prevent overfitting on small sample sizes. In C22-A.8 narrative, 'epochs = 15' conflated MIN_EPOCHS with MAX_EPOCHS; this was repaired in C22-A.9 erratum. Executable runs (C16, C22-B, C22-D) strictly executed MAX_EPOCHS=30, MIN_EPOCHS=15, PATIENCE=10.",
      "verdict": "RESOLVED_AS_VERSIONED_CHANGE_WITH_C22A8_DOCUMENTATION_ERRATUM"
    },
    "D_augmentation": {
      "inconsistency": "Earlier documentation described H-flip + V-flip p=0.5, whereas C22-A.9 reported augmentation disabled.",
      "classification": "VERSIONED_CHANGE",
      "evidence": "Early preprocessing draft (OPEN-PREPROC-003) explored H-flip and V-flip. However, in C4 (Section 11, BASELINE_IDENTITY_NO_AUGMENTATION) and C15 (INV-18), augmentations were formally disabled to maintain physical SAR radiometric geometry and deterministic reproducibility. Executable code and run manifests strictly used zero data augmentation.",
      "verdict": "RESOLVED_AS_VERSIONED_CHANGE"
    },
    "E_sampler": {
      "inconsistency": "Earlier protocol discussed WeightedRandomSampler / inverse dominant-class frequency, whereas C22-A.9 used Candidate F Hybrid sampler.",
      "classification": "VERSIONED_CHANGE",
      "evidence": "Inverse frequency sampling risked severe parent-scene memorization (observed in C3 validation). C4 Section 7 and C15 formally adopted the Candidate F Hybrid Sampler (70% parent uniform + 30% class presence uniform, drawing 72 tiles/epoch with replacement). In C22-B and C22-D, Candidate F was bitwise locked and deterministic per seed. All 19 scientific invariants between Control and Treatment arms were identical.",
      "verdict": "RESOLVED_AS_VERSIONED_CHANGE"
    },
    "F_dataset_version_splits": {
      "inconsistency": "Earlier OPS-01 documentation used 72 TRAIN / 39 DEV / 36 HOLDOUT (147 tiles, 27 parents), whereas later C22-A.9 used OPS02_v1.0.1_FROZEN with 132 TRAIN / 40 DEV / 40 HOLDOUT (212 tiles, 64 parents).",
      "classification": "VERSIONED_CHANGE",
      "evidence": "OPS-01 was the initial 147-tile pilot dataset derived from 27 parent scenes (used in Run 001 and Run 002). In C12\u2013C15, OPS-02 was assembled as a formal multi-scene dataset expansion, establishing 212 physical tiles from 64 independent parent clusters. In C15 narrative, a drafting typo claimed 41 DEV / 39 HOLDOUT; this was corrected in C18 freeze spec v1.0.1 to match the actual manifest counts of 40 DEV / 40 HOLDOUT. Runs C16, C22-B, and C22-D strictly executed on OPS02_v1.0.1_FROZEN.",
      "verdict": "RESOLVED_AS_VERSIONED_CHANGE"
    },
    "G_radiometric_representation": {
      "inconsistency": "Earlier documentation discussed raw DN values and uncalibrated sigma0, while later protocol used 10*log10 or log1p(DN) described as pseudo-dB.",
      "classification": "DOCUMENTATION_ERROR",
      "evidence": "Executable code in exp07_reference.py executes: np.log1p(np.maximum(raw_dn, 0.0)) followed by standardization using TRAIN mean (4.424158) and std (0.469261). C4 Section 3 explicitly proved that spatial 10x10 block-averaging violates Jensen's inequality for physical sigma0 dB calibration. True representation is pseudo-dB / log1p-transformed DN, NOT calibrated physical sigma0 dB.",
      "verdict": "RESOLVED_AS_DOCUMENTATION_ERROR_TERMINOLOGY_BOUNDED"
    },
    "H_metric_selection_semantics": {
      "inconsistency": "Verify primary metric dev_mIoU_phenomena semantics across protocol, training code, checkpoint selection, and reports.",
      "classification": "SAME_AS_PREVIOUS",
      "evidence": "Primary metric dev_mIoU_phenomena is strictly defined as macro unweighted average across dense classes 1..11. Background Class 0 is strictly excluded. In compute_metrics_from_confusion_matrix, classes with GT=0 evaluate to None and are omitted from denominator; classes with GT>0 and TP=0 evaluate to 0.0 and enter the denominator. On OPS-02 DEV, all 11 classes have GT>0, so denominator is always exactly 11. Checkpoint selection strictly selected the epoch maximizing dev_mIoU_phenomena.",
      "verdict": "RESOLVED_CONSISTENT_ACROSS_ALL_LEVELS"
    },
    "I_holdout_quarantine": {
      "inconsistency": "Verify all EXP-07 runs maintained zero HOLDOUT access.",
      "classification": "SAME_AS_PREVIOUS",
      "evidence": "Audited across Run 001, Run 002, Run 003, C22-B, and C22-D manifests and logs: holdout_access_count = 0 in every single run. Zero payload content was accessed. Part III access = 0.",
      "verdict": "RESOLVED_STRICTLY_PRESERVED"
    }
  },
