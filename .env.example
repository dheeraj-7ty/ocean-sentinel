# =============================================================================
# Ocean Sentinel — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================================

# Copernicus Sentinel Hub OAuth2 Credentials
# Obtain from: https://shapps.dataspace.copernicus.eu/dashboard/
# Navigate to User Settings > OAuth clients > Create
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional: Override default API endpoints (usually not needed)
# COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# COPERNICUS_PROCESS_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process
